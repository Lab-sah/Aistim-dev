{
  "manifest_version": 3,
  "name": "Aistim Tool",
  "version": "2.10.1",
  "key": "",
  "update_url": "https://github.com/devtim-lab/aistim-dev/releases/latest/download/updates.xml",
  "description": "AI Multi Userscript Manager \u2014 bundled scripts + auto-sync GitHub, engine userScripts (CSP-safe)",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "userScripts",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Aistim Tool \u2014 Userscript Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/*.js",
        "scripts/index.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
